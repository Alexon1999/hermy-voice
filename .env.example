# --- API Hermes ---
# URL de base de l'API Hermes.
HERMY_API_BASE=https://hermes-api.ualexon.dev/p/hermy/v1
# Clé privée du profil Hermy. Copie ta vraie clé dans .env uniquement.
API_SERVER_KEY=REMPLACE_PAR_TA_CLE
# Nom du modèle/profil appelé par l'API.
HERMY_MODEL=hermy
# Délai maximal de réponse de l'API, en secondes.
REQUEST_TIMEOUT=600

# --- Whisper / reconnaissance vocale locale ---
# Modèle pour les wake words et les commandes : tiny, base, small, medium, large-v3.
# medium reste précis mais est plus lent ; small ou base réduisent le délai au prix de la précision.
WHISPER_MODEL=small
# Langue parlée ; laisser vide pour la détection automatique.
STT_LANGUAGE=fr
# Indice facultatif pour les noms propres ou termes récurrents.
STT_INITIAL_PROMPT=
# Périphérique Faster-Whisper : cpu ou cuda selon la plateforme et l'installation.
WHISPER_DEVICE=cpu
# Type de calcul. int8 convient au CPU ; float16 est courant sur les GPU compatibles.
WHISPER_COMPUTE_TYPE=int8
# Nombre de threads CPU. À ajuster selon le matériel.
WHISPER_CPU_THREADS=6
# Nombre d'hypothèses de décodage : 1 est le plus rapide ; une valeur plus élevée
# peut améliorer la précision au prix d'une transcription plus lente.
WAKE_BEAM_SIZE=1
COMMAND_BEAM_SIZE=1

# --- Audio et détection de parole ---
SAMPLE_RATE=16000
# Seuil d'énergie RMS pour démarrer l'enregistrement d'une commande.
# Augmente-le si le bruit déclenche l'écoute ; baisse-le si la voix est ignorée.
ENERGY_THRESHOLD=0.012
# Seuils du réveil par double claquement ; monte-les si clavier/table déclenchent Hermy.
CLAP_MIN_RMS=0.04
CLAP_MIN_PEAK=0.20
CLAP_MIN_CREST=5.0
# Intervalle accepté entre les deux claquements, en secondes.
CLAP_MIN_INTERVAL=0.22
CLAP_PAIR_WINDOW=0.85
# Silence après la phrase avant de lancer Whisper : 0.7 s accélère la réponse.
# Augmente cette valeur si des pauses au milieu de tes phrases coupent trop tôt.
SILENCE_SECONDS=0.7
# Durée maximale d'une commande après le réveil, en secondes.
COMMAND_TIMEOUT=30
# Durée d'écoute après une réponse avant le retour en veille, en secondes.
FOLLOWUP_TIMEOUT=30

# --- Synthèse vocale (macOS) ---
# Voix macOS utilisée par `say`. Installe d'abord la voix dans Réglages Système.
# `say -v '?'` affiche les noms exacts des voix disponibles. Vide = voix système.
HERMY_TTS_VOICE=

# --- Veille ---
# Durée maximale d'un segment de parole capturé en veille (minimum effectif : 4 s).
WAKE_WINDOW_SECONDS=2.4
# Ancien réglage conservé pour compatibilité ; la détection actuelle est segmentée.
WAKE_CHECK_SECONDS=0.8

# --- Diagnostic ---
# 1 affiche le niveau RMS du micro en veille ; 0 désactive cet affichage.
HERMY_DEBUG_AUDIO=1
