# --- API Hermes ---
# URL de base de l’API HTTPS du profil Hermes Agent.
HERMY_API_BASE=https://hermes-api.ualexon.dev/p/hermy/v1
# Clé privée API_SERVER_KEY du profil hermy sur le VPS. Ne jamais partager cette clé.
API_SERVER_KEY=REMPLACE_PAR_TA_CLE
# Nom du modèle/profil demandé à l’API Hermes.
HERMY_MODEL=hermy

# --- Reconnaissance vocale locale (Faster-Whisper) ---
# Taille du modèle Whisper : tiny, base, small, medium, large-v3 selon ressources et précision voulue.
# base est un compromis de départ ; les modèles plus grands sont plus lents et consomment plus de RAM/CPU.
WHISPER_MODEL=medium
# Langue attendue pour la transcription : fr, en, etc. Laisser vide pour détection automatique.
STT_LANGUAGE=fr

# --- Audio ---
# Fréquence d’échantillonnage audio en Hz ; 16000 est adapté au modèle Whisper utilisé ici.
SAMPLE_RATE=16000
# Délai maximal d’attente d’une réponse de l’API, en secondes.
REQUEST_TIMEOUT=180
# Seuil d’énergie audio au-dessus duquel un son est considéré comme de la voix.
# Baisser légèrement si la voix n’est pas détectée ; augmenter si le bruit déclenche l’écoute.
ENERGY_THRESHOLD=0.012
# Durée de silence consécutif qui marque la fin de la phrase, en secondes.
SILENCE_SECONDS=1.3

# --- Veille et wake words ---
# Intervalle entre deux analyses du son pendant la veille, en secondes.
WAKE_CHECK_SECONDS=1.2
# Durée de la fenêtre audio analysée pour reconnaître un wake word, en secondes.
WAKE_WINDOW_SECONDS=3.2
# Temps maximal accordé pour commencer/parler une commande après le réveil, en secondes.
COMMAND_TIMEOUT=12
# Temps d’attente après la réponse pour une demande suivante sans répéter le wake word, en secondes.
# Si aucune parole n’est détectée, Hermy retourne en veille.
FOLLOWUP_TIMEOUT=8

# --- Diagnostic micro (1 = affiche le niveau du micro et les transcriptions pendant la veille) ---
HERMY_DEBUG_AUDIO=1
